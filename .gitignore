.dev.vars

# local dev database
sqlite.db

# Generated by `npm run cf-typegen`. Pulls in the Workers global types,
# which redefine Response.json() as Promise<unknown> and break the typecheck
# in client components. Nothing references CloudflareEnv, so it is not kept.
cloudflare-env.d.ts
