# Turso Database (get these from `turso db show <name>` and `turso db tokens create <name>`)
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your-auth-token

# Admin Login — use a long, high-entropy value (this is the only admin factor).
# No insecure default: if unset, admin login fails closed.
ADMIN_PASSWORD=your-admin-password

# Session signing secret (HMAC key for the admin session cookie).
# Optional but recommended: generate with `openssl rand -base64 32`.
# If unset, ADMIN_PASSWORD is used as the signing key instead.
SESSION_SECRET=your-random-signing-secret

# Resend (transactional email — get from https://resend.com/api-keys)
RESEND_API_KEY=re_your-api-key

# Public base URL (canonical domain, used for SEO metadata, sitemap, and email links)
# NOTE: NEXT_PUBLIC_* vars are inlined at build time — must be set in the build environment.
# Defaults to the live Cloudflare Workers deployment if unset (see src/lib/site.ts).
NEXT_PUBLIC_BASE_URL=https://lepotilnica.jaksicbojan1.workers.dev
