{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "lepotilnica",
    "main": ".open-next/worker.js",
    "compatibility_date": "2025-03-01",
    "compatibility_flags": ["nodejs_compat"],
    // The site is served from the custom domain lepotilnicabykarin.si (attached
    // via the Cloudflare dashboard). Disable the *.workers.dev host so the same
    // content isn't reachable on two origins — Google treats that as duplicate
    // content and it competes with the apex domain for ranking signals.
    "workers_dev": false,
    "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS"
    },
    // Native Rate Limiting bindings (enforced at the edge, shared across
    // requests). namespace_id is just a unique logical id — no provisioning
    // needed. period must be 10 or 60 (seconds). Consumed via enforceRateLimit()
    // in src/lib/rate-limit.ts.
    "ratelimits": [
        { "name": "AUTH_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 8, "period": 60 } },
        { "name": "BOOKING_RATE_LIMITER", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } },
        { "name": "CANCEL_RATE_LIMITER", "namespace_id": "1003", "simple": { "limit": 12, "period": 60 } }
    ]
}
