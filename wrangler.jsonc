{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "lepotilnica",
    "main": ".open-next/worker.js",
    "compatibility_date": "2025-03-01",
    "compatibility_flags": ["nodejs_compat"],
    // The site will be served from the custom domain lepotilnicabykarin.si.
    // That domain is deliberately detached until launch (a customer found the
    // site and booked before it was ready), so the *.workers.dev host is
    // currently the only way to reach the deployed Worker, for our own testing.
    //
    // FLIP BACK TO false AT LAUNCH, when the custom domain is re-attached:
    // serving the same content on two origins is duplicate content, and the
    // workers.dev host would compete with the apex for ranking signals.
    // Canonicals and sitemap.xml already point only at the apex, which limits
    // that but does not remove it. Don't link the workers.dev URL anywhere
    // public in the meantime — its canonical points at the apex, which does
    // not serve the site yet.
    "workers_dev": true,
    "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS"
    },
    // Native Rate Limiting bindings. namespace_id is just a unique logical id —
    // no provisioning needed. period must be 10 or 60 (seconds). Consumed via
    // enforceRateLimit() in src/lib/rate-limit.ts.
    //
    // These limits are APPROXIMATE and leak badly in production — 20 requests
    // at 1/second got past AUTH_RATE_LIMITER's 8/60s untouched. See the KNOWN
    // LIMITATION block in src/lib/rate-limit.ts for the measurements. Lowering
    // a number here does not make it enforceable, it only changes the nominal
    // figure, so don't reach for that as a fix.
    "ratelimits": [
        { "name": "AUTH_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 8, "period": 60 } },
        { "name": "BOOKING_RATE_LIMITER", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } },
        { "name": "CANCEL_RATE_LIMITER", "namespace_id": "1003", "simple": { "limit": 12, "period": 60 } },
        { "name": "CONTACT_RATE_LIMITER", "namespace_id": "1004", "simple": { "limit": 3, "period": 60 } }
    ]
}
